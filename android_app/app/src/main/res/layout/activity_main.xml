<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".MainActivity">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212" />

    <!-- Splash Overlay (fades out after WebView loads) -->
    <FrameLayout
        android:id="@+id/splash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="40dp">

            <ImageView
                android:id="@+id/splash_logo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="Logo Sonido Celestial"
                android:src="@drawable/logo"
                tools:src="@drawable/logo" />

            <TextView
                android:id="@+id/splash_radio_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Radio Sonido Celestial"
                android:textColor="#FCAD04"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/splash_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Versión 1.0"
                android:textColor="#B3B3B3"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/splash_developer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Desarrollado por\n Ing Reibeiro Velasquez"
                android:textColor="#888888"
                android:textSize="12sp" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
